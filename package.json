{
  "name": "dsh-quota-widget",
  "version": "2.0.0",
  "type": "module",
  "description": "DSH 插件：在 Web 界面右下角显示可配置的多数据源额度 / 用量浮窗，内置 OpenCode Go、DeepSeek、Anthropic、OpenAI 与通用 HTTP 适配器。",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "quota",
    "usage",
    "opencode",
    "deepseek",
    "anthropic",
    "openai"
  ],
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/**/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alone-show/dsh-quota-widget.git"
  },
  "homepage": "https://github.com/Alone-show/dsh-quota-widget#readme",
  "bugs": {
    "url": "https://github.com/Alone-show/dsh-quota-widget/issues"
  }
}
